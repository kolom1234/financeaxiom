SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
# Optional secret: enables deleting the Supabase Auth user in POST /api/account/delete
# SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SEC_USER_AGENT=YourCompanyName contact@yourdomain.com
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PUSH_DATA_ENC_KEY=base64_32_byte_key_here
EVENT_HUB_INTERNAL_TOKEN=local-event-hub-token
# Generate with: node scripts/generate-vapid-keys.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@yourdomain.com
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
AUTH_ALLOWED_REDIRECT_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
ALLOW_MEMORY_READ_FALLBACK=1
TEST_AUTH_BYPASS=1
# Optional API keys. BLS works without a key (25 queries/day); BEA is skipped without a key.
BLS_API_KEY=
BEA_API_KEY=
EIA_API_KEY=DEMO_KEY
# Retention (days) for GDELT index items and notification history.
GDELT_RETENTION_DAYS=90
NOTIFICATION_RETENTION_DAYS=90
